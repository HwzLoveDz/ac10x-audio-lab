CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# CONFIG_PM_ENABLE is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_BRIDGE_MCLK_GPIO=8
CONFIG_BRIDGE_BCLK_GPIO=9
CONFIG_BRIDGE_LRCK_GPIO=10
CONFIG_BRIDGE_DOUT_GPIO=11
CONFIG_BRIDGE_DIN_GPIO=12
CONFIG_BRIDGE_SDA_GPIO=13
CONFIG_BRIDGE_SCL_GPIO=14

CONFIG_SPIRAM=y

CONFIG_LIBC_NEWLIB=y

CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
